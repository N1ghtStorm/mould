fn choose(a: bool, b: bool) -> i32 {
    if a && !b {
        return 1
    } else if a || b {
        return 2
    } else {
        return 3
    }
}

fn main() {
    let left: bool = true
    let right: bool = false
    let same: bool = left == right

    if !same {
        println(choose(left, right))
    } else {
        println(0)
    }
}
